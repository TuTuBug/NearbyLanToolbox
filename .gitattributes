# 统一换行符处理，避免 Windows / macOS / Linux 协作时整文件 diff

* text=auto

# Windows 批处理必须 CRLF，否则某些情况下解析异常
*.bat   text eol=crlf
*.cmd   text eol=crlf

# macOS / Linux 的 shell 脚本必须 LF：一旦被 checkout 成 CRLF，
# macOS 上双击会报 "/bin/bash^M: bad interpreter"。
# 注意 *.cmd 这条规则不覆盖 .command（后缀不同），必须单独声明。
*.command text eol=lf
*.sh      text eol=lf

# PowerShell / C# / 工程文件统一 CRLF（与本项目开发环境一致）
*.ps1   text eol=crlf
*.psm1  text eol=crlf
*.cs    text eol=crlf
*.csproj text eol=crlf
*.sln   text eol=crlf

# 二进制资源
*.ico   binary
*.png   binary
*.jpg   binary
*.exe   binary
*.dll   binary
*.nupkg binary

# 前端与文档保持 LF
*.js    text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.md    text eol=lf
*.json  text eol=lf
# CI 配置在 Linux runner 上执行，LF 最稳妥
*.yml   text eol=lf
*.yaml  text eol=lf
*.py    text eol=lf
*.txt   text eol=lf

# Git 自动生成的内容，语言统计不纳入
native/EmbeddedAssets.g.cs linguist-generated=true
